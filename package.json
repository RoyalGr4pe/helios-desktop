{
  "name": "helios-desktop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A modern glassmorphism desktop dashboard for Linux",
  "main": "electron/main.cjs",
  "author": "Helios Team",
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run electron:dev\"",
    "electron:dev": "node scripts/wait-and-electron.js",
    "mcp": "node mcp/server.cjs",
    "mcp:dev": "concurrently \"npm run mcp\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "electron:build": "npm run build && electron-builder",
    "package:linux": "npm run build && electron-builder --linux AppImage",
    "install:linux": "npm run electron:build && bash scripts/install.sh",
    "uninstall:linux": "bash scripts/uninstall.sh",
    "start": "electron .",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "electron-log": "^5.1.7",
    "framer-motion": "^11.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "~5.4.5",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.helios.desktop",
    "productName": "Helios Desktop",
    "artifactName": "helios-desktop-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "mcp/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "desktop": {
        "StartupNotify": true,
        "StartupWMClass": "Helios Desktop"
      }
    }
  }
}
